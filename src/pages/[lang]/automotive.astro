---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ItemRows from "../../components/ItemRows.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { LOCALES, t, getDict, localizedPath, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface Item {
  title: string;
  text: string;
}

const { lang } = Astro.params as { lang: Locale };
const tt = t(lang);
const stuck = getDict<string[]>(lang, "automotive.stuck.items") ?? [];
const what = getDict<Item[]>(lang, "automotive.what.items") ?? [];
const how = getDict<Item[]>(lang, "automotive.how.items") ?? [];
const receive = getDict<{ k: string; v: string }[]>(lang, "automotive.receive.rows") ?? [];
---

<Layout title={`${tt("automotive.metaTitle")} — ${tt("site.name")}`} description={tt("automotive.metaDescription")}>
  <PageHero label={tt("automotive.label")} title={tt("automotive.title")} lede={tt("automotive.lede")} image="/images/connected-car-fertigung.webp" imagePosition="center 55%">
    <a href={localizedPath(lang, "/blog/cause-15")} class="mt-8 inline-block text-[0.9375rem] font-bold text-white underline decoration-1 underline-offset-4 hover:text-[#d6dcff]">
      {tt("automotive.storyLink")} →
    </a>
  </PageHero>

  <!-- Wo Projekte hängen bleiben -->
  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <h2 class="display-md text-[var(--color-text-on-carbon)]">{tt("automotive.stuck.title")}</h2>
      <ul class="mt-10 max-w-[70ch]">
        {stuck.map((line, idx) => (
          <li class:list={["py-4 text-lg leading-relaxed text-[var(--color-text-on-carbon)]", idx > 0 && "border-t border-[var(--color-hairline-dark)]"]}>{line}</li>
        ))}
      </ul>
      <p class="mt-10 max-w-[60ch] text-lg font-bold leading-relaxed text-[var(--color-text-on-carbon)]">{tt("automotive.stuck.closing")}</p>
    </div>
  </section>

  <!-- Was wir tun -->
  <section class="paper-sheet" id="testing">
    <div class="container-prose py-16 md:py-24">
      <h2 class="display-md" style="color: var(--color-paper-ink);">{tt("automotive.what.title")}</h2>
      <ItemRows items={what} accent="green" />
      <div class="mt-10 border-t pt-8" style="border-color: color-mix(in srgb, var(--color-paper-ink) 18%, transparent);">
        <p class="mono-label" style="color: var(--color-paper-muted);">{tt("automotive.what.alsoTitle")}</p>
        <p class="mt-3 max-w-[80ch] text-base leading-relaxed" style="color: var(--color-paper-ink);">{tt("automotive.what.also")}</p>
      </div>
    </div>
  </section>

  <!-- Wie wir testen -->
  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <h2 class="display-md text-[var(--color-text-on-carbon)]">{tt("automotive.how.title")}</h2>
      <div class="mt-10 grid grid-cols-1 gap-y-10 md:grid-cols-2 md:gap-x-16">
        {how.map((item) => (
          <div class="border-l-2 pl-5" style="border-color: var(--color-cobalt-light);">
            <h3 class="heading-card text-[var(--color-text-on-carbon)]">{item.title}</h3>
            <p class="mt-2 max-w-[56ch] text-base leading-relaxed text-[var(--color-text-on-carbon-muted)]">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Was Sie erhalten + Prozess -->
  <section class="paper-sheet">
    <div class="container-prose grid grid-cols-1 gap-y-14 py-16 md:grid-cols-12 md:gap-x-16 md:py-24">
      <div class="md:col-span-7">
        <h2 class="display-md" style="color: var(--color-paper-ink);">{tt("automotive.receive.title")}</h2>
        <dl class="mt-8">
          {receive.map((row, idx) => (
            <div class="grid grid-cols-1 gap-y-1 py-4 sm:grid-cols-[13rem_1fr] sm:gap-x-8" style={idx > 0 ? "border-top: 1px solid color-mix(in srgb, var(--color-paper-ink) 18%, transparent);" : ""}>
              <dt class="font-bold" style="color: var(--color-paper-ink);">{row.k}</dt>
              <dd style="color: var(--color-paper-muted);">{row.v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="md:col-span-5">
        <h2 class="display-md" style="color: var(--color-paper-ink);">{tt("automotive.process.title")}</h2>
        <p class="mt-8 text-lg leading-relaxed" style="color: var(--color-paper-muted);">{tt("automotive.process.text")}</p>
      </div>
    </div>
  </section>

  <CtaBanner headline={tt("automotive.cta.headline")} sub={tt("automotive.cta.sub")} />
</Layout>
