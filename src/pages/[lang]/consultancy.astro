---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ItemRows from "../../components/ItemRows.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { LOCALES, t, getDict, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface Item {
  title: string;
  text: string;
}

const { lang } = Astro.params as { lang: Locale };
const tt = t(lang);
const items = getDict<Item[]>(lang, "consultancy.items") ?? [];
---

<Layout title={tt("consultancy.title")} description={tt("consultancy.lead")}>
  <PageHero label="Private 5G" title={tt("consultancy.title")} lede={tt("consultancy.lead")} image="/images/private5g-fabrik.webp" imagePosition="center 45%" />

  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <ItemRows items={items} />
    </div>
  </section>

  <CtaBanner />
</Layout>
