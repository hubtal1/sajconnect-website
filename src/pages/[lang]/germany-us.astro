---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { LOCALES, t, getDict, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface Row {
  k: string;
  de: string;
  us: string;
}

const { lang } = Astro.params as { lang: Locale };
const tt = t(lang);
const rows = getDict<Row[]>(lang, "atlantic.rows") ?? [];
const offer = getDict<{ title: string; text: string }[]>(lang, "atlantic.offer") ?? [];
const read = getDict<{ label: string; href: string }[]>(lang, "atlantic.read") ?? [];
---

<Layout title={`${tt("atlantic.metaTitle")} — ${tt("site.name")}`} description={tt("atlantic.metaDescription")}>
  <PageHero label={tt("nav.germanyUs")} title={tt("atlantic.title")} lede={tt("atlantic.lede")} />

  <!-- Vergleich: auf dem Handy je Thema ein Block, ab md eine Tabelle -->
  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <h2 class="display-md text-[var(--color-text-on-carbon)]">{tt("atlantic.tableTitle")}</h2>
      <div class="mt-10 hidden grid-cols-[12rem_1fr_1fr] gap-x-10 border-b border-[var(--color-hairline-dark)] pb-3 md:grid">
        <span class="mono-label text-[var(--color-text-on-carbon-faint)]">{tt("atlantic.colTopic")}</span>
        <span class="mono-label text-[var(--color-saj-green-bright)]">{tt("atlantic.colDe")}</span>
        <span class="mono-label text-[var(--color-cobalt-light)]">{tt("atlantic.colUs")}</span>
      </div>
      <dl class="mt-6 md:mt-0">
        {rows.map((row, idx) => (
          <div class:list={["grid grid-cols-1 gap-y-3 py-6 md:grid-cols-[12rem_1fr_1fr] md:gap-x-10", idx > 0 && "border-t border-[var(--color-hairline-dark)]"]}>
            <dt class="font-bold text-[var(--color-text-on-carbon)]">{row.k}</dt>
            <dd class="text-base leading-relaxed text-[var(--color-text-on-carbon-muted)]">
              <span class="mono-label mr-2 text-[var(--color-saj-green-bright)] md:hidden">{tt("atlantic.colDe")}</span>{row.de}
            </dd>
            <dd class="text-base leading-relaxed text-[var(--color-text-on-carbon-muted)]">
              <span class="mono-label mr-2 text-[var(--color-cobalt-light)] md:hidden">{tt("atlantic.colUs")}</span>{row.us}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="paper-sheet">
    <div class="container-prose grid grid-cols-1 gap-y-12 py-16 md:grid-cols-12 md:gap-x-16 md:py-24">
      <div class="md:col-span-7">
        <h2 class="display-md" style="color: var(--color-paper-ink);">{tt("atlantic.offerTitle")}</h2>
        <div class="mt-8 space-y-8">
          {offer.map((o) => (
            <div class="border-l-2 pl-5" style="border-color: var(--color-cobalt-light);">
              <h3 class="heading-card" style="color: var(--color-paper-ink);">{o.title}</h3>
              <p class="mt-2 max-w-[56ch] text-base leading-relaxed" style="color: var(--color-paper-muted);">{o.text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="md:col-span-5">
        <p class="mono-label" style="color: var(--color-paper-muted);">{tt("atlantic.readTitle")}</p>
        <ul class="mt-4 space-y-3">
          {read.map((r) => (
            <li>
              <a href={r.href} class="text-base font-bold text-[var(--color-cobalt-light)] underline decoration-1 underline-offset-4">{r.label} →</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
