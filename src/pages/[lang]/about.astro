---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { LOCALES, t, getDict, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface Diff {
  n: string;
  text: string;
}

const { lang } = Astro.params as { lang: Locale };
const tt = t(lang);
const diffs = getDict<Diff[]>(lang, "about.differentiators.items") ?? [];
// "Standorte" / "Locations" / "Localizações" aus der Faktenzeile wiederverwenden
const locationsLabel = getDict<{ k: string }[]>(lang, "dossier.hero.spec.rows")?.[0]?.k ?? tt("ui.headquarter");
---

<Layout title={tt("about.title")} description={tt("about.lead")}>
  <PageHero label="SAJ Connect GmbH" title={tt("about.title")} lede={tt("about.lead")} />

  <!-- Einstieg: Text links, Eckdaten rechts -->
  <section class="surface-carbon">
    <div class="container-prose grid grid-cols-1 gap-y-10 py-16 md:grid-cols-12 md:gap-x-16 md:py-24">
      <p class="text-lg leading-relaxed text-[var(--color-text-on-carbon)] md:col-span-7">{tt("about.leadSecond")}</p>
      <dl class="md:col-span-5 md:border-l md:border-[var(--color-hairline-dark)] md:pl-10">
        <dt class="mono-label text-[var(--color-text-on-carbon-faint)]">{tt("ui.focus")}</dt>
        <dd class="mt-1.5 text-base font-bold text-[var(--color-text-on-carbon)]">{tt("about.focusValue")}</dd>
        <dt class="mono-label mt-6 text-[var(--color-text-on-carbon-faint)]">{locationsLabel}</dt>
        <dd class="mt-1.5 text-base font-bold text-[var(--color-text-on-carbon)]">{tt("landing.locations")}</dd>
      </dl>
    </div>
  </section>

  <!-- Der Name -->
  <section class="paper-sheet">
    <div class="container-prose grid grid-cols-1 gap-y-6 py-16 md:grid-cols-12 md:gap-x-16 md:py-24">
      <div class="md:col-span-4">
        <p class="mono-label" style="color: var(--color-cobalt-light);">{tt("about.name.label")}</p>
      </div>
      <div class="md:col-span-8">
        <h2 class="display-md" style="color: var(--color-paper-ink);">{tt("about.name.title")}</h2>
        <p class="mt-6 max-w-[62ch] text-base leading-relaxed" style="color: var(--color-paper-muted);">{tt("about.name.text")}</p>
        <p class="mt-6 text-base font-bold" style="color: var(--color-cobalt-light);">{tt("about.name.closing")}</p>
      </div>
    </div>
  </section>

  <!-- Mission als volle Farbfläche -->
  <section class="text-white" style="background-color: #001ec9;">
    <div class="container-prose py-16 md:py-24">
      <p class="text-sm font-bold" style="color: #9fe58f;">{tt("ui.mission")}</p>
      <p class="mt-5 max-w-[30ch] font-display font-bold leading-[1.15]" style="font-size: clamp(1.75rem, 3.4vw, 2.75rem);">
        {tt("about.mission.text")}
      </p>
    </div>
  </section>

  <!-- Was uns auszeichnet: offene Liste -->
  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <h2 class="display-md text-[var(--color-text-on-carbon)]">{tt("about.differentiators.title")}</h2>
      <ul class="mt-10 grid grid-cols-1 gap-x-12 md:grid-cols-2">
        {diffs.map((d) => (
          <li class="border-t border-[var(--color-hairline-dark)] py-5 text-base leading-relaxed text-[var(--color-text-on-carbon)]">{d.text}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBanner />
</Layout>
