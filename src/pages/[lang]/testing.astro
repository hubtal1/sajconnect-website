---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ItemRows from "../../components/ItemRows.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { LOCALES, t, getDict, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface Item {
  title: string;
  text: string;
}

interface Group {
  headline: string;
  items: Item[];
}

const { lang } = Astro.params as { lang: Locale };
const tt = t(lang);
const groups = getDict<Group[]>(lang, "testing.groups") ?? [];
---

<Layout title={tt("testing.title")} description={tt("testing.lead")}>
  <PageHero label={tt("testing.chapterLabel")} title={tt("testing.title")} lede={tt("testing.lead")} image="/images/testing-panel.webp" imagePosition="center 40%" />

  {groups.map((group, gIdx) => (
    <section class:list={[gIdx % 2 === 1 ? "paper-sheet" : "surface-carbon"]}>
      <div class="container-prose py-16 md:py-24">
        <h2 class="display-md" style={gIdx % 2 === 1 ? "color: var(--color-paper-ink);" : ""}>{group.headline}</h2>
        <ItemRows items={group.items} accent={gIdx % 2 === 1 ? "green" : "cobalt"} />
      </div>
    </section>
  ))}

  <CtaBanner />
</Layout>
