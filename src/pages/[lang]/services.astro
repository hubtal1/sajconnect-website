---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ItemRows from "../../components/ItemRows.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { LOCALES, t, getDict, localizedPath, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface Domain {
  title: string;
  tag: string;
  description: string;
}
interface EngagementModel {
  title: string;
  text: string;
}

const { lang } = Astro.params as { lang: Locale };
const tt = t(lang);
const domains = getDict<Domain[]>(lang, "services.domains") ?? [];
const engagementModels = getDict<EngagementModel[]>(lang, "services.engagement.models") ?? [];

// Bereiche mit eigener Fachseite (Reihenfolge wie services.domains)
const PAGES: (string | null)[] = ["/consultancy", "/esim", "/iot", "/ntn", "/6g", "/connectivity-platform", "/connected-car", "/frmcs", "/kritis", null];
const rows = domains.map((d, i) => ({
  title: d.title,
  text: d.description,
  href: PAGES[i] ? localizedPath(lang, PAGES[i] as string) : undefined,
}));

const subAreas = [
  { title: tt("consultancy.title"), lead: tt("consultancy.lead"), href: localizedPath(lang, "/consultancy"), tag: "Private 5G" },
  { title: tt("esim.title"), lead: tt("esim.teaser"), href: localizedPath(lang, "/esim"), tag: "eSIM & iSIM" },
  { title: tt("iot.title"), lead: tt("iot.teaser"), href: localizedPath(lang, "/iot"), tag: "IoT Connectivity" },
  { title: tt("ntn.title"), lead: tt("ntn.teaser"), href: localizedPath(lang, "/ntn"), tag: "NTN" },
  { title: tt("sixg.title"), lead: tt("sixg.teaser"), href: localizedPath(lang, "/6g"), tag: "6G" },
  { title: tt("platform.title"), lead: tt("platform.teaser"), href: localizedPath(lang, "/connectivity-platform"), tag: "Connectivity Platform" },
  { title: tt("testing.title"), lead: tt("testing.lead"), href: localizedPath(lang, "/testing"), tag: "Testing" },
  { title: tt("vehicle.title"), lead: tt("vehicle.lead"), href: localizedPath(lang, "/connected-car"), tag: "Connected Car" },
  { title: tt("frmcs.title"), lead: tt("frmcs.teaser"), href: localizedPath(lang, "/frmcs"), tag: tt("nav.frmcs") },
  { title: tt("kritis.title"), lead: tt("kritis.teaser"), href: localizedPath(lang, "/kritis"), tag: tt("nav.kritis") },
];
const lineStyles = ["border-top: 3px solid currentColor;", "border-top: 3px dashed currentColor;", "border-top: 7px double currentColor;"];
---

<Layout title={tt("services.title")} description={tt("services.lead")}>
  <PageHero label={tt("ui.capabilities")} title={tt("services.title")} lede={tt("services.lead")} />

  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <ItemRows items={rows} />
    </div>
  </section>

  <section class="paper-sheet">
    <div class="container-prose py-16 md:py-24">
      <h2 class="display-md" style="color: var(--color-paper-ink);">{tt("ui.deepDivesHeadline")}</h2>
      <ul class="mt-10">
        {subAreas.map((area, idx) => (
          <li class:list={[idx > 0 && "border-t"]} style="border-color: color-mix(in srgb, var(--color-paper-ink) 18%, transparent);">
            <a href={area.href} class="group grid grid-cols-1 gap-y-2 py-7 md:grid-cols-[13rem_1fr_auto] md:items-baseline md:gap-x-10">
              <span class="mono-label" style={`color: var(${idx % 2 === 0 ? "--color-cobalt-light" : "--color-saj-green-bright"});`}>{area.tag}</span>
              <span>
                <span class="heading-card block transition-colors group-hover:text-[var(--color-cobalt-light)]" style="color: var(--color-paper-ink);">{area.title}</span>
                <span class="mt-2 block max-w-[62ch] text-sm leading-relaxed" style="color: var(--color-paper-muted);">{area.lead}</span>
              </span>
              <span class="mono-label transition-colors group-hover:text-[var(--color-cobalt-light)]" style="color: var(--color-paper-muted);">{tt("ui.readMore")} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <h2 class="display-md text-[var(--color-text-on-carbon)]">{tt("services.engagement.headline")}</h2>
      <p class="lede mt-6 max-w-[58ch]">{tt("services.engagement.sub")}</p>
      <div class="mt-12 grid grid-cols-1 gap-10 text-[var(--color-text-on-carbon)] md:grid-cols-3 md:gap-12">
        {engagementModels.map((model, idx) => (
          <div style={lineStyles[idx % 3]} class="pt-4">
            <h3 class="heading-card mt-2.5">{model.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-on-carbon-muted)]">{model.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
