---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ItemRows from "../../components/ItemRows.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { LOCALES, t, getDict, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

interface Item {
  title: string;
  tag: string;
  text: string;
}

const { lang } = Astro.params as { lang: Locale };
const tt = t(lang);
const items = getDict<Item[]>(lang, "vehicle.items") ?? [];
---

<Layout title={tt("vehicle.title")} description={tt("vehicle.lead")}>
  <PageHero label={tt("connectedCar.chapterLabel")} title={tt("vehicle.title")} lede={tt("vehicle.lead")} image="/images/connected-car-fertigung.webp" imagePosition="center 55%" />

  <section class="surface-carbon">
    <div class="container-prose py-16 md:py-24">
      <ItemRows items={items} />
    </div>
  </section>

  <CtaBanner />
</Layout>
