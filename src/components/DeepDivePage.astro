---
/**
 * Fachseite mit Eckdaten, Abschnitten, Beitrag und Quellen (FRMCS, KRITIS).
 * Offen gesetzt wie die Startseite: Haarlinien statt Kacheln, keine Zähler.
 */
import Layout from "../layouts/Layout.astro";
import CtaBanner from "./CtaBanner.astro";
import PageHero from "./PageHero.astro";
import HeroCta from "./HeroCta.astro";
import { getDict, type Locale } from "../i18n/utils";

interface Fact {
  k: string;
  v: string;
}
interface Section {
  title: string;
  paras: string[];
  bullets: string[];
  after: string[];
}
interface Source {
  label: string;
  url: string;
}
/** Optionaler Einstieg wie auf den Schwerpunktseiten: Problem, Lieferung, Button. */
interface Pitch {
  title: string;
  lede: string;
  metaTitle: string;
  factsLink: string;
  stuckTitle: string;
  stuck: string[];
  receiveTitle: string;
  receive: Fact[];
  receiveClosing: string;
  background: string;
}
interface DeepDive {
  chapter: string;
  title: string;
  lede: string;
  factsTitle: string;
  facts: Fact[];
  sections: Section[];
  contributionTitle: string;
  contribution: string[];
  limitsTitle?: string;
  limits?: string;
  asOf: string;
  sourcesTitle: string;
  sources: Source[];
  pitch?: Pitch;
}

interface Props {
  lang: Locale;
  ns: "frmcs" | "kritis" | "esim" | "iot" | "ntn" | "sixg" | "platform";
}

const { lang, ns } = Astro.props;
// Kopf-Fotos (Unsplash, siehe BILDQUELLEN.md)
const HERO: Record<Props["ns"], { image: string; position: string }> = {
  frmcs: { image: "/images/frmcs-oberleitung.webp", position: "center 60%" },
  kritis: { image: "/images/kritis-mast.webp", position: "center 35%" },
  esim: { image: "/images/esim-platine.webp", position: "center" },
  iot: { image: "/images/iot-zaehler.webp", position: "center 45%" },
  ntn: { image: "/images/ntn-satellit.webp", position: "center 40%" },
  sixg: { image: "/images/6g-radioteleskop.webp", position: "center 70%" },
  platform: { image: "/images/plattform-netzwerk.webp", position: "center" },
};
const page = getDict<DeepDive>(lang, ns);
if (!page) throw new Error(`Fachseite ${ns} fehlt in ${lang}`);

const pitch = page.pitch;

const bullet =
  "relative pl-6 before:absolute before:left-0 before:top-[0.8em] before:h-px before:w-3 before:bg-[var(--color-cobalt-light)]";
---

<Layout title={pitch ? `${pitch.metaTitle} — SAJ Connect` : page.title} description={pitch?.lede ?? page.lede}>
  <PageHero label={page.chapter} title={pitch?.title ?? page.title} lede={pitch?.lede ?? page.lede} image={HERO[ns].image} imagePosition={HERO[ns].position}>
    {pitch && <HeroCta secondary={{ href: "#hintergrund", label: pitch.factsLink }} />}
  </PageHero>

  {pitch && (
    <section class="surface-carbon">
      <div class="container-prose py-16 md:py-24">
        <h2 class="display-md text-[var(--color-text-on-carbon)]">{pitch.stuckTitle}</h2>
        <ul class="mt-10 max-w-[70ch]">
          {pitch.stuck.map((line, idx) => (
            <li class:list={["py-4 text-lg leading-relaxed text-[var(--color-text-on-carbon)]", idx > 0 && "border-t border-[var(--color-hairline-dark)]"]}>{line}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {pitch && (
    <section class="paper-sheet">
      <div class="container-prose py-16 md:py-24">
        <h2 class="display-md" style="color: var(--color-paper-ink);">{pitch.receiveTitle}</h2>
        <dl class="mt-8 max-w-[64rem]">
          {pitch.receive.map((row, idx) => (
            <div class="grid grid-cols-1 gap-y-1 py-4 sm:grid-cols-[15rem_1fr] sm:gap-x-8" style={idx > 0 ? "border-top: 1px solid color-mix(in srgb, var(--color-paper-ink) 18%, transparent);" : ""}>
              <dt class="font-bold" style="color: var(--color-paper-ink);">{row.k}</dt>
              <dd style="color: var(--color-paper-muted);">{row.v}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-8 max-w-[60ch] text-lg font-bold leading-relaxed" style="color: var(--color-paper-ink);">{pitch.receiveClosing}</p>
      </div>
    </section>
  )}

  <section class="surface-carbon">
    <div class="container-prose pb-20 pt-6 md:pb-28" id={pitch ? "hintergrund" : undefined}>
      {pitch && (
        <div class="pt-14 md:pt-20">
          <p class="mono-label text-[var(--color-cobalt-light)]">{pitch.background}</p>
          <h2 class="display-md mt-3 max-w-[30ch] text-[var(--color-text-on-carbon)]">{page.title}</h2>
          <p class="mt-5 max-w-[68ch] text-lg leading-relaxed text-[var(--color-text-on-carbon-muted)]">{page.lede}</p>
        </div>
      )}
      <!-- Eckdaten -->
      <div class="grid grid-cols-1 gap-y-6 pt-10 md:grid-cols-12 md:gap-x-12">
        <h2 class="heading-card text-[var(--color-text-on-carbon)] md:col-span-4">{page.factsTitle}</h2>
        <dl class="md:col-span-8">
          {page.facts.map((fact, i) => (
            <div class:list={["grid grid-cols-1 gap-y-1 py-3 sm:grid-cols-[11rem_1fr] sm:gap-x-6", i > 0 && "border-t border-[var(--color-hairline-dark)]"]}>
              <dt class="mono-label text-[var(--color-text-on-carbon-faint)]">{fact.k}</dt>
              <dd class="mono-spec text-[var(--color-text-on-carbon)]">{fact.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Fachabschnitte -->
      {page.sections.map((section) => (
        <div class="mt-16 grid grid-cols-1 gap-y-6 border-t border-[var(--color-hairline-dark)] pt-10 md:grid-cols-12 md:gap-x-12">
          <h2 class="heading-card text-[var(--color-text-on-carbon)] md:col-span-4">{section.title}</h2>
          <div class="space-y-5 md:col-span-8">
            {section.paras.map((p) => (
              <p class="max-w-[68ch] text-base leading-relaxed text-[var(--color-text-on-carbon-muted)]">{p}</p>
            ))}
            {section.bullets.length > 0 && (
              <ul class="max-w-[68ch] space-y-3 text-base leading-relaxed text-[var(--color-text-on-carbon-muted)]">
                {section.bullets.map((b) => <li class={bullet}>{b}</li>)}
              </ul>
            )}
            {section.after.map((p) => (
              <p class="max-w-[68ch] text-base leading-relaxed text-[var(--color-text-on-carbon-muted)]">{p}</p>
            ))}
          </div>
        </div>
      ))}

      <!-- Beitrag (entfällt, wenn der Einstieg die Lieferung schon nennt) -->
      {!pitch && (
      <div class="mt-16 grid grid-cols-1 gap-y-6 border-t border-[var(--color-hairline-dark)] pt-10 md:grid-cols-12 md:gap-x-12">
        <div class="md:col-span-4">
          <h2 class="heading-card text-[var(--color-saj-green-bright)]">{page.contributionTitle}</h2>
        </div>
        <div class="md:col-span-8">
          <ul class="max-w-[68ch] space-y-3 text-base leading-relaxed text-[var(--color-text-on-carbon)]">
            {page.contribution.map((c) => <li class={bullet}>{c}</li>)}
          </ul>
          {page.limits && (
            <div class="mt-10">
              <p class="mono-label text-[var(--color-text-on-carbon-faint)]">{page.limitsTitle}</p>
              <p class="mt-3 max-w-[68ch] text-sm leading-relaxed text-[var(--color-text-on-carbon-muted)]">{page.limits}</p>
            </div>
          )}
        </div>
      </div>
      )}

      <!-- Quellen -->
      <div class="mt-16 grid grid-cols-1 gap-y-6 border-t border-[var(--color-hairline-dark)] pt-10 md:grid-cols-12 md:gap-x-12">
        <h2 class="mono-label text-[var(--color-text-on-carbon-faint)] md:col-span-4">{page.sourcesTitle}</h2>
        <div class="md:col-span-8">
          <ul class="space-y-2 text-sm">
            {page.sources.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[var(--color-text-on-carbon-muted)] underline decoration-[var(--color-hairline-dark)] decoration-1 underline-offset-4 transition-colors hover:text-[var(--color-cobalt-light)] hover:decoration-[var(--color-cobalt-light)]"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-[var(--color-text-on-carbon-faint)]">{page.asOf}</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>
