---
import LanguageSwitcher from "./LanguageSwitcher.tsx";
import ThemeToggle from "./ThemeToggle.tsx";
import Logo from "./Logo.astro";
import { getLocaleFromUrl, t, localizedPath, type Locale } from "../i18n/utils";

const locale: Locale = getLocaleFromUrl(Astro.url);
const tt = t(locale);

// Schwerpunkte stehen direkt im Menü, die übrigen Kompetenzen im Dropdown.
const focus = [
  { label: tt("nav.automotive"), href: localizedPath(locale, "/automotive") },
  { label: tt("nav.private5g"), href: localizedPath(locale, "/private-5g") },
  { label: tt("nav.rail"), href: localizedPath(locale, "/frmcs") },
];

const capabilities = [
  { label: tt("nav.overview"), href: localizedPath(locale, "/capabilities") },
  { label: tt("nav.esim"), href: localizedPath(locale, "/esim") },
  { label: tt("nav.iot"), href: localizedPath(locale, "/iot") },
  { label: tt("nav.ntn"), href: localizedPath(locale, "/ntn") },
  { label: tt("nav.platform"), href: localizedPath(locale, "/connectivity-platform") },
  { label: tt("nav.kritis"), href: localizedPath(locale, "/kritis") },
];

const nav = [
  { label: tt("nav.fieldStories"), href: localizedPath(locale, "/blog") },
  { label: tt("nav.about"), href: localizedPath(locale, "/about") },
];
---

<header class="sticky top-0 z-40 border-b border-[var(--color-hairline-dark)] bg-[var(--color-carbon)] text-[var(--color-text-on-carbon)]">
  <div class="container-prose flex h-20 items-center justify-between gap-4">
    <a href={localizedPath(locale, "/")} class="group flex items-center transition-opacity hover:opacity-80" aria-label="SAJ Connect — Home">
      <Logo width={180} withTagline={true} />
    </a>

    <nav class="hidden items-center gap-6 text-sm xl:flex">
      {focus.map((item) => (
        <a href={item.href} class="text-[var(--color-text-on-carbon-muted)] hover:text-[var(--color-cobalt-light)] transition-colors">
          {item.label}
        </a>
      ))}
      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 text-[var(--color-text-on-carbon-muted)] hover:text-[var(--color-cobalt-light)] transition-colors">
          {tt("nav.capabilities")}
          <svg width="9" height="9" viewBox="0 0 10 10" fill="none" class="transition-transform group-open:rotate-180">
            <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ul class="absolute left-0 mt-3 min-w-[240px] border border-[var(--color-hairline-dark)] bg-[var(--color-carbon)] py-2">
          {capabilities.map((s) => (
            <li>
              <a href={s.href} class="block px-5 py-2.5 text-sm text-[var(--color-text-on-carbon-muted)] transition-colors hover:bg-[var(--color-carbon-soft)] hover:text-[var(--color-cobalt-light)]">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </details>

      {nav.map((item) => (
        <a href={item.href} class="text-[var(--color-text-on-carbon-muted)] hover:text-[var(--color-cobalt-light)] transition-colors">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:idle />
      <LanguageSwitcher client:idle currentLocale={locale} pathname={Astro.url.pathname} />
      <a href={localizedPath(locale, "/contact")} class="btn-dossier ml-1 hidden !px-4 !py-2 md:inline-flex">
        {tt("nav.projectCheck")}
      </a>
    </div>
  </div>

  <details class="xl:hidden border-t border-[var(--color-hairline-dark)]">
    <summary class="container-prose flex items-center justify-between py-3 cursor-pointer text-sm">
      {tt("ui.menu")}
    </summary>
    <nav class="container-prose flex flex-col gap-1 pb-5 text-sm">
      {focus.map((s) => (
        <a href={s.href} class="py-2 text-[var(--color-text-on-carbon-muted)] hover:text-[var(--color-cobalt-light)]">
          {s.label}
        </a>
      ))}
      <p class="mt-4 mono-label-sm text-[var(--color-text-on-carbon-faint)]">
        {tt("nav.capabilities")}
      </p>
      {capabilities.map((s) => (
        <a href={s.href} class="py-2 text-[var(--color-text-on-carbon-muted)] hover:text-[var(--color-cobalt-light)]">
          {s.label}
        </a>
      ))}
      <p class="mt-4 mono-label-sm text-[var(--color-text-on-carbon-faint)]">
        {tt("ui.company")}
      </p>
      {[...nav, { label: tt("nav.careers"), href: localizedPath(locale, "/careers") }, { label: tt("nav.contact"), href: localizedPath(locale, "/contact") }].map((item) => (
        <a href={item.href} class="py-2 text-[var(--color-text-on-carbon-muted)] hover:text-[var(--color-cobalt-light)]">
          {item.label}
        </a>
      ))}
    </nav>
  </details>
</header>
