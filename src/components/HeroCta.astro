---
/** Hauptbutton "Projektcheck anfragen" im Seitenkopf, mit Hinweiszeile und optionalem Zweitlink. */
import { getLocaleFromUrl, t, localizedPath, type Locale } from "../i18n/utils";

interface Props {
  secondary?: { href: string; label: string };
}

const locale: Locale = getLocaleFromUrl(Astro.url);
const tt = t(locale);
const { secondary } = Astro.props;
---

<div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
  <a
    href={localizedPath(locale, "/contact")}
    class="inline-flex items-center bg-white px-7 py-3.5 text-[0.9375rem] font-bold tracking-[0.01em] transition-colors duration-150 hover:bg-[#d6dcff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
    style="color: #001ec9;"
  >
    {tt("nav.projectCheck")}
  </a>
  {secondary && (
    <a href={secondary.href} class="text-[0.9375rem] font-bold text-white underline decoration-1 underline-offset-4 transition-colors hover:text-[#d6dcff]">
      {secondary.label} →
    </a>
  )}
</div>
<p class="mt-3 text-sm" style="color: #aab4f0;">{tt("nav.projectCheckNote")}</p>
