---
import { getLocaleFromUrl, t, localizedPath, type Locale } from "../i18n/utils";

interface Props {
  /** Seiteneigene Überschrift; ohne Angabe die allgemeine Abschlusszeile */
  headline?: string;
  sub?: string;
}

const locale: Locale = getLocaleFromUrl(Astro.url);
const tt = t(locale);
const headline = Astro.props.headline ?? tt("home.cta.headline");
const sub = Astro.props.sub ?? tt("home.cta.sub");
---

<!-- Abschluss jeder Seite: volle Fläche in SAJ-Blau, in beiden Themes gleich. -->
<section class="text-white" style="background-color: #001ec9;">
  <div class="container-prose py-16 md:py-20">
    <div class="grid grid-cols-1 gap-y-8 md:grid-cols-12 md:items-end md:gap-x-16">
      <div class="md:col-span-8">
        <h2 class="font-display font-bold leading-[1.12]" style="font-size: clamp(1.75rem, 3.2vw, 2.6rem);">
          {headline}
        </h2>
        <p class="mt-5 max-w-[56ch] text-lg leading-relaxed" style="color: #d6dcff;">{sub}</p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a
          href={localizedPath(locale, "/contact")}
          class="inline-flex items-center bg-white px-7 py-3.5 text-[0.9375rem] font-bold tracking-[0.01em] transition-colors duration-150 hover:bg-[#d6dcff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          style="color: #001ec9;"
        >
          {tt("home.cta.button")}
        </a>
      </div>
    </div>
  </div>
</section>
