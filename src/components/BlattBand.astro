---
import { getLocaleFromUrl, t, getDict, type Locale } from "../i18n/utils";

interface Item {
  title: string;
  text: string;
}

const locale: Locale = getLocaleFromUrl(Astro.url);
const tt = t(locale);
const items = getDict<Item[]>(locale, "home.differentiators.items") ?? [];
---

<!-- Haltung als volle Farbfläche in SAJ-Blau, in beiden Themes gleich. -->
<section class="text-white" style="background-color: #001ec9;" id="haltung">
  <div class="container-prose py-16 md:py-24">
    <div class="grid grid-cols-1 gap-y-6 md:grid-cols-12 md:items-end md:gap-x-16">
      <h2 class="font-display font-bold leading-[1.15] md:col-span-7" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">
        {tt("landing.bandTitle")}
      </h2>
      <p class="text-lg leading-relaxed md:col-span-5" style="color: #d6dcff;">{tt("landing.bandText")}</p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-y-8 border-t pt-10 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-4" style="border-color: rgba(255,255,255,0.22);">
      {items.map((item) => (
        <div>
          <h3 class="text-base font-bold">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed" style="color: #c9d1ff;">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
