---
import { getLocaleFromUrl, t, getDict, type Locale } from "../i18n/utils";

interface Note {
  k: string;
  title: string;
  text: string;
}

const locale: Locale = getLocaleFromUrl(Astro.url);
const tt = t(locale);
const notes = getDict<Note[]>(locale, "landing.fieldNotes") ?? [];
---

<!-- Feldnotizen: Erfahrungssätze auf Papier mit Messraster statt Werbesätzen. -->
<section class="paper-sheet" id="feld">
  <div class="container-prose py-16 md:py-24">
    <h2 class="display-md" style="color: var(--color-paper-ink);">{tt("landing.fieldTitle")}</h2>
    <div class="mt-10 grid grid-cols-1 gap-y-10 md:grid-cols-3 md:gap-x-12">
      {notes.map((note) => (
        <div class="border-l-2 pl-5" style="border-color: var(--color-cobalt-light);">
          <p class="mono-label" style="color: var(--color-paper-muted);">{note.k}</p>
          <h3 class="heading-card mt-2" style="color: var(--color-paper-ink);">{note.title}</h3>
          <p class="mt-3 text-base leading-relaxed" style="color: var(--color-paper-muted);">{note.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
